generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AccountTokenType {
  INVITE
  PASSWORD_RESET
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  LIVE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WatchSessionStatus {
  ACTIVE
  ENDED
  BLOCKED
}

enum VideoStatus {
  EMPTY
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum MaterialType {
  PDF
  LINK
  CHECKLIST
  SPREADSHEET
  PROMPT
  FILE
}

enum VideoProvider {
  PANDA
  MUX
}

enum IntegrationProvider {
  PANDA
  THEMEMBERS
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  cpf                   String?                @unique
  phone                 String?
  passwordHash          String?
  avatarUrl             String?
  role                  UserRole               @default(STUDENT)
  status                UserStatus             @default(ACTIVE)
  blockedAt             DateTime?
  blockedReason         String?
  lastLoginAt           DateTime?
  sessionVersion        Int                    @default(1)
  passwordChangedAt     DateTime?
  inviteAcceptedAt      DateTime?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  favorites             Favorite[]
  devices               Device[]
  watchSessions         WatchSession[]
  certificates          Certificate[]
  notifications         Notification[]
  accountTokens         AccountToken[]
  externalCustomers     ExternalCustomer[]
  externalSubscriptions ExternalSubscription[]
  externalAccessGrants  ExternalAccessGrant[]
  auditLogs             AuditLog[]             @relation("AuditActor")

  @@index([role, status, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
}

model Course {
  id                   String                @id @default(cuid())
  title                String
  slug                 String                @unique
  description          String?
  shortDescription     String?
  heroImageUrl         String?
  cardImageUrl         String?
  trailerAssetId       String?
  status               CourseStatus          @default(DRAFT)
  featured             Boolean               @default(false)
  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categories           Category[]
  modules              CourseModule[]
  enrollments          Enrollment[]
  favorites            Favorite[]
  learningPathItems    LearningPathCourse[]
  certificateEnabled   Boolean               @default(true)
  certificateTitle     String?
  sourceProvider       IntegrationProvider?
  sourceExternalId     String?
  sourceSyncedAt       DateTime?
  certificates         Certificate[]
  productMappings      ProductCourse[]
  externalAccessGrants ExternalAccessGrant[]

  @@unique([sourceProvider, sourceExternalId])
  @@index([status, featured, publishedAt, createdAt])
}

model CourseModule {
  id               String               @id @default(cuid())
  courseId         String
  title            String
  position         Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sourceProvider   IntegrationProvider?
  sourceExternalId String?
  sourceSyncedAt   DateTime?
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons          Lesson[]

  @@unique([courseId, position])
  @@unique([sourceProvider, sourceExternalId])
  @@index([courseId])
}

model Lesson {
  id               String               @id @default(cuid())
  moduleId         String
  title            String
  description      String?
  type             LessonType           @default(VIDEO)
  position         Int
  durationSec      Int?
  videoUploadId    String?              @unique
  videoAssetId     String?              @unique
  videoPlaybackId  String?              @unique
  videoStatus      VideoStatus          @default(EMPTY)
  videoError       String?
  preview          Boolean              @default(false)
  published        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sourceProvider   IntegrationProvider?
  sourceExternalId String?
  sourceSyncedAt   DateTime?
  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  watchSessions    WatchSession[]
  chapters         LessonChapter[]
  materials        LessonMaterial[]
  transcript       LessonTranscript?
  videoResourceId  String?
  videoResource    VideoAsset?          @relation(fields: [videoResourceId], references: [id], onDelete: SetNull)

  @@unique([moduleId, position])
  @@unique([sourceProvider, sourceExternalId])
  @@index([moduleId])
  @@index([moduleId, published, position])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)
  source    String?
  startsAt  DateTime         @default(now())
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, status, updatedAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  positionSec Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, updatedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
}

model LearningPath {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  description  String?
  heroImageUrl String?
  published    Boolean              @default(false)
  position     Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  courses      LearningPathCourse[]

  @@index([published, position, createdAt])
}

model LearningPathCourse {
  learningPathId String
  courseId       String
  position       Int
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([learningPathId, courseId])
  @@unique([learningPathId, position])
  @@index([courseId])
}

model LessonChapter {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  startSec  Int
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId, startSec])
}

model LessonMaterial {
  id        String       @id @default(cuid())
  lessonId  String
  title     String
  type      MaterialType @default(LINK)
  url       String
  position  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
}

model LessonTranscript {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  content   String
  language  String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  code     String   @unique
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, issuedAt])
  @@index([courseId])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([readAt, createdAt])
}

model Device {
  id            String         @id @default(cuid())
  userId        String
  fingerprint   String
  label         String?
  userAgent     String?
  lastIp        String?
  lastSeenAt    DateTime       @default(now())
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchSessions WatchSession[]

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
}

model WatchSession {
  id                     String             @id @default(cuid())
  userId                 String
  lessonId               String
  deviceId               String?
  playbackNonce          String             @unique
  ipAddress              String?
  status                 WatchSessionStatus @default(ACTIVE)
  blockReason            String?
  lastPositionSec        Int                @default(0)
  maxCreditedPositionSec Int                @default(0)
  watchedSec             Int                @default(0)
  startedAt              DateTime           @default(now())
  lastSeenAt             DateTime           @default(now())
  endedAt                DateTime?
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson                 Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  device                 Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, status, lastSeenAt])
  @@index([lessonId])
  @@index([deviceId, status])
  @@index([status, endedAt])
  @@index([status, lastSeenAt])
}

model VideoAsset {
  id                 String        @id @default(cuid())
  provider           VideoProvider
  providerAssetId    String
  providerExternalId String?
  providerLibraryId  String?
  playerUrl          String?
  thumbnailUrl       String?
  status             VideoStatus   @default(PROCESSING)
  durationSec        Int?
  error              String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lessons            Lesson[]

  @@unique([provider, providerAssetId])
  @@index([provider, providerExternalId])
  @@index([status])
}

model ExternalProduct {
  id                  String                 @id @default(cuid())
  provider            IntegrationProvider
  externalId          String
  productCode         String?
  checkoutReferenceId String?
  title               String
  description         String?
  status              String?
  raw                 Json?
  lastSyncedAt        DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  courses             ProductCourse[]
  subscriptions       ExternalSubscription[]
  accessGrants        ExternalAccessGrant[]

  @@unique([provider, externalId])
  @@index([provider, productCode])
  @@index([provider, checkoutReferenceId])
}

model ProductCourse {
  externalProductId String
  courseId          String
  externalProduct   ExternalProduct @relation(fields: [externalProductId], references: [id], onDelete: Cascade)
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([externalProductId, courseId])
  @@index([courseId])
}

model ExternalCustomer {
  id         String              @id @default(cuid())
  provider   IntegrationProvider
  externalId String
  userId     String
  email      String?
  raw        Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([provider, userId])
  @@index([email])
  @@index([updatedAt])
}

model ExternalSubscription {
  id                     String              @id @default(cuid())
  provider               IntegrationProvider
  externalSubscriptionId String?
  userId                 String
  externalProductId      String
  status                 String
  paymentLastDate        DateTime?
  expiresAt              DateTime?
  raw                    Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalProduct        ExternalProduct     @relation(fields: [externalProductId], references: [id], onDelete: Cascade)

  @@unique([provider, userId, externalProductId])
  @@index([externalSubscriptionId])
  @@index([expiresAt])
  @@index([updatedAt])
}

model ExternalAccessGrant {
  id                String              @id @default(cuid())
  provider          IntegrationProvider
  userId            String
  courseId          String
  externalProductId String
  status            EnrollmentStatus    @default(ACTIVE)
  startsAt          DateTime            @default(now())
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  externalProduct   ExternalProduct     @relation(fields: [externalProductId], references: [id], onDelete: Cascade)

  @@unique([provider, userId, courseId, externalProductId])
  @@index([userId, courseId, status, expiresAt])
  @@index([externalProductId, status])
}

model WebhookEvent {
  id          String                 @id @default(cuid())
  provider    IntegrationProvider
  eventKey    String
  eventType   String
  payloadHash String
  payload     Json
  status      IntegrationEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime               @default(now())
  processedAt DateTime?

  @@unique([provider, eventKey])
  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([status, processedAt])
}

model IntegrationLog {
  id        String              @id @default(cuid())
  provider  IntegrationProvider
  level     String              @default("INFO")
  action    String
  message   String
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  actorEmail  String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
